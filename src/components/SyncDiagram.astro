---
// How sync works, animated: sealed packets travel from one device through
// the server you run to the other device. The server's screen only ever
// shows ciphertext. The figcaption says the same in words.
import Icon from "./Icon.astro";

// Made-up ciphertext for the server screen (hex, like the padded blobs it stores).
const cipher = [
  "9f3a c1e0 77b2 04d9",
  "e81c 5a0f d3b7 6c21",
  "0b9e 44f1 a87d 3e5c",
  "c2d4 19aa f06b 8e73",
  "71fe 2b80 5dc9 a413",
  "3a6c e7d2 09b5 f18e",
];
---

<figure class="sync" data-loop>
  <div class="row" aria-hidden="true">
    <div class="node">
      <Icon name="sidebar" size={20} class="text-accent" />
      <b>Laptop</b>
      <span class="plain">Spaces · Pinned · Settings</span>
    </div>
    <div class="wire">
      <span class="pk pk-1"><Icon name="lock" size={10} /></span>
      <span class="pk pk-2"><Icon name="lock" size={10} /></span>
    </div>
    <div class="node server">
      <Icon name="server" size={20} class="text-accent" />
      <b>Your server</b>
      <span class="screen"><span class="scroll">{[...cipher, ...cipher].map((c) => <span>{c}</span>)}</span></span>
    </div>
    <div class="wire">
      <span class="pk pk-3"><Icon name="lock" size={10} /></span>
      <span class="pk pk-4"><Icon name="lock" size={10} /></span>
    </div>
    <div class="node">
      <Icon name="sidebar" size={20} class="text-accent" />
      <b>Desktop</b>
      <span class="plain">Spaces · Pinned · Settings</span>
    </div>
  </div>
  <figcaption>
    Each device encrypts before it uploads. The server you run keeps an anonymous public key and encrypted, padded data,
    nothing it could read.
  </figcaption>
</figure>

<style>
  .sync {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr minmax(36px, 0.6fr) 1.25fr minmax(36px, 0.6fr) 1fr;
    align-items: stretch;
  }
  .node {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 0;
    padding: 16px 10px;
    border: 1px solid var(--color-line-strong);
    border-radius: 14px;
    background: linear-gradient(180deg, #232327, #1a1a1d);
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.35;
    text-align: center;
  }
  .node b {
    color: var(--color-fg);
    font-size: 0.8125rem;
  }
  .server {
    border-style: dashed;
    border-color: rgb(215 166 101 / 0.45);
    box-shadow: 0 0 40px -12px rgb(215 166 101 / 0.35);
  }
  .screen {
    display: block;
    width: 100%;
    height: 3.6em;
    overflow: hidden;
    padding: 0 6px;
    border-radius: 6px;
    background: #0a0a0c;
    color: var(--color-steel);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.2;
    mask: linear-gradient(transparent, #000 25%, #000 75%, transparent);
  }
  .scroll {
    display: flex;
    flex-direction: column;
    animation: cipher 9s linear infinite;
  }
  .wire {
    position: relative;
    align-self: center;
    height: 2px;
    margin: 0 4px;
    background: repeating-linear-gradient(90deg, rgb(215 166 101 / 0.5) 0 6px, transparent 6px 11px);
  }
  .pk {
    position: absolute;
    top: 50%;
    left: 0;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #fff3d6, #d7a665 60%, #a8742f);
    box-shadow: 0 0 14px rgb(246 223 176 / 0.8);
    color: #1a1309;
    animation: travel 3.2s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }
  .pk-2 {
    animation-delay: -1.6s;
  }
  .pk-3 {
    animation-delay: -0.8s;
  }
  .pk-4 {
    animation-delay: -2.4s;
  }
  figcaption {
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  @keyframes travel {
    0% { left: 0%; opacity: 0; scale: 0.5; }
    15% { opacity: 1; scale: 1; }
    85% { opacity: 1; scale: 1; }
    100% { left: 100%; opacity: 0; scale: 0.5; }
  }
  @keyframes cipher {
    to { translate: 0 -50%; }
  }
  @media (max-width: 639px) {
    .row {
      grid-template-columns: 1fr;
      grid-template-rows: auto 40px auto 40px auto;
    }
    .wire {
      align-self: stretch;
      justify-self: center;
      width: 2px;
      height: auto;
      margin: 4px 0;
      background: repeating-linear-gradient(180deg, rgb(215 166 101 / 0.5) 0 6px, transparent 6px 11px);
    }
    .pk {
      left: 50%;
      animation-name: travel-down;
    }
    @keyframes travel-down {
      0% { top: 0%; opacity: 0; }
      15%, 85% { opacity: 1; }
      100% { top: 100%; opacity: 0; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pk {
      display: none;
    }
  }
</style>
