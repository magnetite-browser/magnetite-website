---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { repo } from "../site";
import { localizePath, useTranslations, type Lang } from "../i18n/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizePath(lang, "/");
const links = [
  { href: `${home}#features`, label: t("nav.features") },
  { href: `${home}#privacy`, label: t("nav.privacy") },
  { href: `${home}#faq`, label: t("nav.faq") },
  { href: localizePath(lang, "/download/"), label: t("nav.download") },
];
const path = Astro.url.pathname;
---

<header class="site-header sticky top-0 z-30">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 px-5 sm:h-16 sm:flex-nowrap">
    <a href={home} class="flex h-14 items-center gap-2.5 rounded-md sm:h-auto" aria-label="Magnetite, home">
      <Logo id="header" size={30} motion="hover" />
      <span class="font-display text-[1.1875rem] font-semibold tracking-[-0.01em]">Magnetite</span>
    </a>
    <nav
      aria-label={t("nav.label")}
      class="order-last -mx-5 w-[calc(100%+2.5rem)] overflow-x-auto border-t border-line px-5 sm:order-none sm:mx-0 sm:w-auto sm:flex-1 sm:border-0 sm:px-0"
    >
      <ul class="flex h-11 items-center gap-6 text-[0.9375rem] text-secondary sm:h-auto sm:justify-end">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="nav-link whitespace-nowrap" aria-current={l.href === path ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href={repo.url} class="btn btn-secondary ml-auto h-9 px-4 text-sm sm:ml-0" data-magnetic="0.2">
      <Icon name="code" size={16} />
      <span>{t("nav.source")}</span>
    </a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    background: rgb(12 12 14 / 0.9);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    backdrop-filter: blur(16px) saturate(150%);
  }
  .nav-link {
    position: relative;
    padding: 4px 0;
    border-radius: 4px;
    transition: color 200ms;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--color-bronze), var(--color-champagne), var(--color-bronze));
    scale: 0 1;
    transition: scale 350ms var(--ease-out-expo);
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-fg);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    scale: 1 1;
  }
</style>
