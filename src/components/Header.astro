---
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { repo } from "../site";
import { stars } from "../github";
import { localizePath, useTranslations, type Lang } from "../i18n/ui";

type Props = { lang: Lang };
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizePath(lang, "/");
const links = [
  { href: `${home}#features`, label: t("nav.features") },
  { href: `${home}#privacy`, label: t("nav.privacy") },
  { href: `${home}#faq`, label: t("nav.faq") },
  { href: localizePath(lang, "/download/"), label: t("nav.download") },
];
const path = Astro.url.pathname;
// null while GitHub has not answered: the button then shows no count.
const starCount = await stars();
const compact = new Intl.NumberFormat(lang, { notation: "compact", maximumFractionDigits: 1 });
---

<header class="site-header sticky top-0 z-30">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-8 px-5 sm:h-16 sm:flex-nowrap">
    <a href={home} class="flex h-14 items-center gap-2.5 rounded-md sm:h-auto" aria-label="Magnetite, home">
      <Logo id="header" size={30} motion="hover" />
      <span class="font-display text-[1.1875rem] font-semibold tracking-[-0.01em]">Magnetite</span>
    </a>
    <nav
      aria-label={t("nav.label")}
      class="order-last -mx-5 w-[calc(100%+2.5rem)] overflow-x-auto border-t border-line px-5 sm:order-none sm:mx-0 sm:w-auto sm:flex-1 sm:border-0 sm:px-0"
    >
      <ul class="flex h-11 items-center gap-6 text-[0.9375rem] text-secondary sm:h-auto sm:justify-end">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="nav-link whitespace-nowrap" aria-current={l.href === path ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href={repo.url} class="btn btn-secondary ml-auto h-9 px-4 text-sm sm:ml-0" data-magnetic="0.2">
      <!-- GitHub's mark, the one icon here that is not drawn for this site (Icon.astro). -->
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false" class="shrink-0">
        <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
      </svg>
      <span class="sr-only">{t("nav.source")}</span>
      {
        starCount !== null && (
          <span class="stars">
            <Icon name="star" size={14} />
            {compact.format(starCount)}
            <span class="sr-only">{t("nav.stars")}</span>
          </span>
        )
      }
    </a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid rgb(255 255 255 / 0.06);
    background: rgb(12 12 14 / 0.9);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    backdrop-filter: blur(16px) saturate(150%);
  }
  /* The repository's GitHub stars, set off inside the GitHub button. */
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-left: 4px;
    padding-left: 12px;
    border-left: 1px solid var(--color-line-strong);
    color: var(--color-secondary);
    font-variant-numeric: tabular-nums;
  }
  .nav-link {
    position: relative;
    padding: 4px 0;
    border-radius: 4px;
    transition: color 200ms;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 1.5px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--color-bronze), var(--color-champagne), var(--color-bronze));
    scale: 0 1;
    transition: scale 350ms var(--ease-out-expo);
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--color-fg);
  }
  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    scale: 1 1;
  }
</style>
