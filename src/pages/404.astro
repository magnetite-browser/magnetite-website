---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
---

<Base title="Page not found" description="This page does not exist." index={false}>
  <PageHeader eyebrow="404" title='This page is <span class="text-brass">not here.</span>' lead="Maybe it moved, or the link has a typo." />
  <div class="mx-auto max-w-3xl px-5 pt-10">
    <a href="/" class="btn btn-primary" data-magnetic="0.25">Go to the home page</a>
  </div>
</Base>
