  <!-- Closing -->
  <section class="px-5 pt-16 sm:pt-24" aria-label="Get involved">
    <div class="closing relative isolate mx-auto max-w-7xl overflow-hidden rounded-[32px] border border-line px-5">
      <div class="absolute inset-0 -z-10"><FieldCanvas /></div>
      <div class="closing-shade absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="mx-auto max-w-2xl py-16 text-center sm:py-20">
        <p class="mx-auto max-w-lg text-lg leading-relaxed text-secondary" data-reveal>
          Follow the project, build it from source, tell us what breaks.
        </p>
        <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal>
          <a href={repo.url} class="btn btn-primary" data-magnetic="0.25"><Icon name="code" size={18} />Source code</a>
          <a href="/download/" class="btn btn-secondary" data-magnetic="0.25">Download options</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero-fallback {
    background:
      radial-gradient(45% 55% at 72% 42%, rgb(226 98 43 / 0.14), transparent 70%),
      radial-gradient(40% 50% at 20% 80%, rgb(147 164 184 / 0.08), transparent 70%),
      var(--color-ink);
  }
  .hero-shade {
    background:
      linear-gradient(90deg, rgb(12 12 14 / 0.85) 0%, rgb(12 12 14 / 0.55) 40%, rgb(12 12 14 / 0) 70%),
      linear-gradient(180deg, transparent 70%, var(--color-ink) 100%);
    pointer-events: none;
  }
  @media (max-width: 1023px) {
    .hero-shade {
      background: linear-gradient(
        180deg,
        rgb(12 12 14 / 0.2) 0%,
        rgb(12 12 14 / 0.75) 45%,
        rgb(12 12 14 / 0.9) 70%,
