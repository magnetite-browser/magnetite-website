  <!-- FAQ -->
  <section id="faq" class="mx-auto grid max-w-7xl gap-10 px-5 pt-16 sm:pt-24 lg:grid-cols-[1fr_1.7fr] lg:gap-16" aria-labelledby="faq-title">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow" data-reveal>FAQ</p>
      <h2 id="faq-title" class="section-title mt-5 font-display" data-reveal>Questions.</h2>
      <p class="mt-5 text-lg leading-relaxed text-secondary" data-reveal>
        Not answered here? <a href={repo.issues} class="link">Ask on GitHub</a>.
      </p>
    </div>
    <div class="space-y-3">
      {
        faq.map((item, i) => (
          <details class:list={["qa", `d-${i % 4}`]} data-reveal>
            <summary class="flex items-center justify-between gap-6 px-6 py-5 text-lg font-medium">
              {item.q}
