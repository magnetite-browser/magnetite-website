---
import Base from "../layouts/Base.astro";
import Icon, { type IconName } from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
import FieldCanvas from "../components/FieldCanvas.astro";
import SyncDiagram from "../components/SyncDiagram.astro";
import Terminal from "../components/Terminal.astro";
import type { SceneId } from "../demo/api";
import { ARC_SHUTDOWN, LATEST_VERSION, PLATFORMS, docs, repo } from "../site";

const ticker = [
  "Sidebar tabs",
  "Spaces",
  "Command bar",
  "Auto-archive",
  "Split view",
  "Peek",
  "Chrome extensions",
  "Picture-in-picture",
  "Smart folders",
  "Private profiles",
  "Clean links",
  "Encrypted sync",
];

// Import from other browsers (docs/spec/import.md).
const importSources = ["Arc", "Chrome", "Brave", "Edge", "Vivaldi", "Opera", "Chromium", "Firefox", "Zen"];
const imported = [
  "Arc’s spaces and Zen’s workspaces; one space per profile from the others",
  "Pinned tabs and the tabs you have open",
  "Tab groups and bookmarks, as folders",
  "Arc’s favorites and Zen’s essentials",
  "Each further profile as its own Magnetite profile",
];
const notImported = [
  "Passwords: they stay in your password manager",
  "Cookies, logins and history",
  "Extensions: install them again from the Chrome Web Store",
];

const reasons: { icon: IconName; title: string; text: string }[] = [
  {
    icon: "archive",
    title: "Tabs that tidy themselves",
    text: "Closing a tab archives it instead of throwing it away. Tabs you have not looked at for 12 hours move to the archive on their own, and the archive stays searchable.",
  },
  {
    icon: "globe",
    title: "Chromium underneath",
    text: "Sites work as they do in Chrome. Extensions install from the Chrome Web Store, password managers included, and Chromium’s sandbox and site isolation stay on.",
  },
  {
    icon: "shield",
    title: "Nobody watching",
    text: "No telemetry, no account. Sync is optional, end-to-end encrypted, through Magnetite’s free server or one you can host yourself.",
  },
];

// The tour's scenes (src/demo/film.ts plays them in the window). `focus` is
// the part of the window, in its own 1280 × 800 pixels as "x y w h", that the
// camera shows; `narrow` the same for small screens.
const film: { id: SceneId; label: string; title: string; text: string; points: string[]; focus: string; narrow: string }[] = [
  {
    id: "sidebar",
    label: "The sidebar",
    title: "Everything in its place.",
    text: "Tabs live in a vertical sidebar. What you keep stays pinned at the top; what you opened today sits below it and tidies itself away.",
    points: [
      "Favorites sit above everything, shared by every space.",
      "Pinned tabs remember their home address and go back to it in one click.",
      "Smart folders fill themselves with your pull requests, merge requests or tickets.",
    ],
    focus: "0 0 820 800",
    narrow: "0 0 500 520",
  },
  {
    id: "spaces",
    label: "Spaces",
    title: "One sidebar, many spaces.",
    text: "Each space has its own icon, colour and profile, so work logins and private ones never meet. The window takes a tint of the space you are in.",
    points: [
      "Switch spaces with ⌘⌥← → or a two-finger swipe on the sidebar.",
      "Every space keeps its own pinned tabs and its own Today.",
      "Hide the sidebar with ⌘S; at the left edge it slides out over the page.",
    ],
    focus: "0 0 820 800",
    narrow: "0 200 560 600",
  },
  {
    id: "command",
    label: "Command bar",
    title: "One bar for everything.",
    text: "⌘T opens the command bar over the page. Type an address, a search, the name of an open tab, something you archived last week, or a command.",
    points: [
      "Open tabs, the archive and commands in one list.",
      "Picking an open tab switches to it, even in another space, instead of opening a duplicate.",
      "Searches go to the engine you choose.",
    ],
    focus: "264 0 1016 660",
    narrow: "420 80 710 420",
  },
  {
    id: "split",
    label: "Split view",
    title: "Side by side.",
    text: "Put up to four pages next to each other, each with its own navigation. In the sidebar they become one item.",
    points: ["⌘⇧= opens a new split.", "Or drag one tab onto another.", "Each page keeps its own history and extensions."],
    focus: "0 0 1280 800",
    narrow: "0 160 1280 640",
  },
  {
    id: "peek",
    label: "Peek",
    title: "Look without leaving.",
    text: "Shift-click a link, or follow one away from a pinned site, and it opens as a Peek over the page you were on.",
    points: ["⌘O keeps it as a tab.", "One click moves it into a split.", "Esc, and it is gone."],
    focus: "0 0 1280 800",
    narrow: "0 0 860 600",
  },
  {
    id: "archive",
    label: "Archive",
    title: "Nothing gets lost.",
    text: "Closing a tab archives it instead of throwing it away. Tabs you have not looked at for 12 hours move to the archive on their own.",
    points: [
      "The archive stays searchable, in the sidebar and from the command bar.",
      "⌘⇧T brings back the last tab.",
      "Kept on your device, for 90 days by default.",
    ],
    focus: "0 0 820 800",
    narrow: "0 0 500 520",
  },
];

// The smaller features. A large live window plays the scene of the card
// that is pointed at (`showcase` in src/scripts/film.ts; src/demo/film.ts has
// the scenes), with its camera on `focus` ("x y w h" in the window's own
// 1280 × 800 pixels). Each card shows one piece of the real interface:
// public/cards/<scene>.webp, what the selector `shot` matches in the window
// at `still` of the scene (its first `first` matches, with `pad` pixels
// around them, at most `max` wide; scripts/make-card-pictures.mjs takes the
// pictures).
const features: { scene: SceneId; title: string; text: string; focus: string; shot: string; first?: number; pad?: number; max?: number; still: number }[] = [
  {
    scene: "reopen",
    title: "Archive instead of close",
    text: "Closed tabs go to a local, searchable archive, kept for 90 days by default. ⌘⇧T brings back the last one.",
    focus: "0 290 590 510",
    shot: ".space-list .row.newtab, .space-list .row.newtab ~ .row",
    still: 0.34,
  },
  {
    scene: "pip",
    title: "Picture-in-picture",
    text: "Leave a tab with a playing video and it floats, with its own controls: play and pause, 15 seconds back or forward, back to the tab.",
    focus: "330 40 950 760",
    shot: ".pip",
    pad: 0,
    still: 0.5,
  },
  {
    scene: "smart",
    title: "Smart folders",
    text: "Folders that fill themselves with your pull requests, merge requests or tickets from GitHub, GitLab, Jira or YouTrack, self-hosted servers included.",
    focus: "0 170 590 520",
    shot: ".space-list .row:has([data-smart]), .space-list .row[title^='https://git']",
    still: 0.55,
  },
  {
    scene: "profiles",
    title: "Profiles per space",
    text: "Shared, separate or private logins for each space and favorite. Private profiles live in memory and leave nothing on disk.",
    focus: "500 60 780 690",
    shot: ".iso-row .seg",
    first: 2,
    pad: 10,
    still: 0.8,
  },
  {
    scene: "extensions",
    title: "Chrome extensions",
    text: "Install from the Chrome Web Store, pin icons to the sidebar, reach every extension from the Extensions menu. Password managers such as Bitwarden work.",
    focus: "0 0 590 520",
    shot: ".hdr, .addr",
    still: 0.5,
  },
  {
    scene: "media",
    title: "Media controls",
    text: "Music or video in a tab you are not looking at gets a row in the sidebar: play, pause, skip, mute, or jump to the tab.",
    focus: "0 0 590 520",
    shot: ".media",
    pad: 9,
    still: 0.25,
  },
  {
    scene: "links",
    title: "Clean links",
    text: "Copy a page’s link without tracking parameters (⌘⇧C), exactly as it is, or as Markdown.",
    focus: "0 0 590 520",
    shot: ".addr, .addr-status",
    still: 0.55,
  },
  {
    scene: "site",
    title: "Site controls",
    text: "Zoom, permissions and clearing a site’s stored data, in the site panel (⌘⇧O).",
    focus: "0 0 590 520",
    shot: ".site-panel .panel-group",
    first: 1,
    pad: 2,
    still: 0.7,
  },
  {
    scene: "capture",
    title: "Capture",
    text: "Take a screenshot of the page with ⌘⇧2, without a separate app: an element, a region, what is visible, or the whole page.",
    focus: "0 290 880 510",
    shot: ".capture-selection, .capture-size",
    pad: 12,
    still: 0.5,
  },
  {
    scene: "import",
    title: "Import from other browsers",
    text: "Spaces, pinned tabs, tab groups, bookmarks and open tabs from Arc, Chrome and other Chromium-based browsers, Firefox or Zen, read on your computer.",
    focus: "0 110 900 690",
    shot: ".pg-app .flex-wrap, .pg-app .flex-wrap + .set-hint",
    pad: 10,
    max: 300,
    still: 0.9,
  },
];

const shortcuts = [
  { keys: ["⌘", "T"], what: "New tab or search" },
  { keys: ["⌘", "L"], what: "Edit the address" },
  { keys: ["⌘", "W"], what: "Archive the tab" },
  { keys: ["⌘", "⇧", "T"], what: "Reopen the last one" },
  { keys: ["⌘", "D"], what: "Pin or unpin" },
  { keys: ["⌘", "S"], what: "Hide the sidebar" },
  { keys: ["⌘", "⌥", "←→"], what: "Switch space" },
  { keys: ["⌘", "⇧", "="], what: "New split" },
  { keys: ["⌘", "⇧", "C"], what: "Copy a clean link" },
  { keys: ["⌘", "⇧", "2"], what: "Take a screenshot" },
];
/** The same keys on Windows and Linux: Magnetite puts Ctrl where macOS has ⌘. */
const pcKey: Record<string, string> = { "⌘": "Ctrl", "⌥": "Alt", "⇧": "Shift" };

const privacyPoints = [
  "No telemetry and no usage statistics.",
  "No account. Everything works without signing in.",
  "Archive, history and favicons stay on your device, in a folder only your user can read.",
  "Private profiles keep nothing on disk.",
  "Smart-folder tokens go only to the service they belong to, and are never synced or logged.",
  "Magnetite checks GitHub Releases for signed updates at start and once a day. You can turn that off in Settings → About.",
];

const facts: { title: string; text: string }[] = [
  { title: "Rust and Chromium", text: "The app is written in Rust and embeds Chromium through the Chromium Embedded Framework." },
  { title: "Clean room", text: "No Arc code, assets or branding. Behaviour is specified in our own words." },
  { title: "No CLA", text: "Contributions come in under the EUPL. You keep your copyright." },
];

const faq: { q: string; a: string }[] = [
  {
    q: "Is this Arc?",
    a: `No. Magnetite is an independent open-source project and is not affiliated with, endorsed by or sponsored by The Browser Company. It works in a similar way (sidebar, spaces, command bar, archive) and imports your Arc sidebar, so you can move over before Arc shuts down on ${ARC_SHUTDOWN}. It contains no Arc code, assets or branding.`,
  },
  {
    q: "Which platforms?",
    a: "macOS 13 or later and Linux (x86_64 and ARM64). Magnetite is developed and used daily on Macs with Apple silicon; the packages for Intel Macs and Linux are experimental. Windows (x86_64) is in preparation.",
  },
  {
    q: "Is it free?",
    a: "Yes. Magnetite is free to use and open source under the European Union Public Licence (EUPL-1.2). You do not need an account.",
  },
  {
    q: "How does sync work?",
    a: "Sync is optional. Use Magnetite’s free sync server (hosted in Germany, no sign-up) or run the small magnetite-sync server yourself (one program and a Postgres database, with Docker Compose or a Helm chart). Your first device creates a sync chain and shows a 24-word sync code; other devices join by entering it. Everything is encrypted on the device before upload, and the words never leave your devices, so the server only stores an anonymous key and padded ciphertext: no email, no password, no device names. Spaces, pinned tabs, favorites and settings sync; cookies and logins never do. If you lose every device and the 24 words, the synced data cannot be recovered, by design.",
  },
  {
    q: "Will my extensions work?",
    a: "Most should. Extensions install from the Chrome Web Store inside Magnetite and run on Chromium’s own extension system. Password managers such as Bitwarden work. Extension badges (the small counts on icons) are not shown yet.",
  },
  {
    q: "Can I bring my tabs from another browser?",
    a: "Yes: from Arc, Chromium-based browsers (Chrome, Brave, Edge, Vivaldi, Opera, Chromium), Firefox and Zen. Settings → Data → Import from another browser lists the ones on your computer. An import adds spaces next to the ones you have: pinned tabs, tab groups and bookmarks become folders, open tabs land in Today, Arc’s favorites and Zen’s essentials become favorites, and each further browser profile gets its own Magnetite profile. On first start, Magnetite also picks up your Arc sidebar by itself. The files are read on your computer and nothing is uploaded; the other browser is not changed. Passwords, cookies, history and extensions are not copied: passwords stay in your password manager, and extensions install again from the Chrome Web Store.",
  },
  {
    q: "Is it ready for daily use?",
    a: "Not for everyone yet. Things can break, including the format of the data on disk. On Intel Macs and Linux, sites that only serve H.264 video or AAC audio do not play yet. If you try it, keep your old browser around and tell us what breaks.",
  },
];
---

<Base
  title="Magnetite"
  description="Magnetite is an open-source desktop browser with sidebar tabs, spaces, a command bar and auto-archive, built in Rust on Chromium. No account, no telemetry."
>
  <!-- Hero: a live field of iron filings around the mark -->
  <section class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
    <div class="hero-fallback absolute inset-0 -z-20" aria-hidden="true"></div>
    <div class="absolute inset-0 -z-10"><FieldCanvas anchor="#hero-magnet" /></div>
    <div class="hero-shade absolute inset-0 -z-10" aria-hidden="true"></div>

    <div
      class="mx-auto grid max-w-7xl items-center gap-6 px-5 pt-10 pb-16 sm:pt-16 lg:min-h-[min(820px,calc(100svh-4rem))] lg:grid-cols-[1.15fr_0.85fr] lg:pb-24"
    >
      <div class="relative z-10 order-2 lg:order-1">
        <p class="chip load d-0">
          <span class="live"></span>
          Open source · EUPL-1.2
        </p>
        <h1 id="hero-title" class="hero-title load font-display d-1">
          Your tabs,<br />
          <span class="text-brass">magnetized.</span>
        </h1>
        <p class="load mt-7 max-w-xl text-lg leading-relaxed text-secondary d-2 sm:text-xl">
          Magnetite is an open-source browser that keeps your tabs in a sidebar, sorts them into spaces and archives what you
          stop using. Chromium inside, Rust around it. No account, no telemetry.
        </p>
        <div class="load mt-10 flex flex-wrap items-center gap-3 d-3">
          <a href="/download/" class="btn btn-primary h-13 px-7 text-base" data-magnetic="0.25">
            <Icon name="download" size={18} />
            Download
          </a>
          <a href={repo.url} class="btn btn-secondary h-13 px-7 text-base" data-magnetic="0.25">
            <Icon name="code" size={18} />
            Source code
          </a>
        </div>
        <p class="load mt-8 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs tracking-wide text-muted d-4">
          <span class="text-accent">Fe₃O₄</span>
          <span aria-hidden="true">·</span>
          <span>Runs on macOS with Apple silicon, built from source</span>
          <span aria-hidden="true">·</span>
          <span>Linux and Windows in preparation</span>
        </p>
      </div>

      <div class="order-1 flex justify-center lg:order-2">
        <div id="hero-magnet" class="magnet load-pop" data-tilt>
          <span class="halo" aria-hidden="true"></span>
          <span class="halo halo-2" aria-hidden="true"></span>
          <Logo id="hero" motion="live" class="magnet-logo" />
        </div>
      </div>
    </div>
    <a href="#features" class="scroll-cue" aria-label="Scroll to the tour"><span></span></a>
  </section>

  <!-- Ticker -->
  <section class="marquee border-y border-line bg-ink-2/80 py-4" aria-label="What Magnetite does">
    <ul class="marquee-track font-display text-lg text-secondary">
      {
        ticker.map((t) => (
          <li class="flex items-center gap-12 whitespace-nowrap">
            {t}
            <span class="spark" aria-hidden="true">
              ✦
            </span>
          </li>
        ))
      }
    </ul>
    <ul class="marquee-track font-display text-lg text-secondary" aria-hidden="true">
      {
        ticker.map((t) => (
          <li class="flex items-center gap-12 whitespace-nowrap">
            {t}
            <span class="spark">✦</span>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- The tour: a window with Magnetite's own sidebar and command bar, live
       (src/demo/), going through six scenes. On large screens it is pinned
       and the scroll position is the playhead; elsewhere it plays by itself
       (src/scripts/film.ts). Without JavaScript: a picture and the captions. -->
  <section id="features" class="film relative pt-16 sm:pt-24" aria-labelledby="tour-title" data-film>
    <h2 id="tour-title" class="sr-only">A tour of Magnetite</h2>
    <div class="film-track" data-film-track>
      <div class="film-stage">
        <div class="film-copy">
          <ol class="film-scenes">
            {
              film.map((s, i) => (
                <li id={`scene-${s.id}`} class="film-scene" data-scene={s.id} data-focus={s.focus} data-focus-narrow={s.narrow}>
                  <p class="eyebrow">
                    <span class="film-count">
                      {String(i + 1).padStart(2, "0")}
                      <span class="text-muted"> / {String(film.length).padStart(2, "0")}</span>
                    </span>
                    {s.label}
                  </p>
                  <h3 class="film-title font-display">{s.title}</h3>
                  <p class="film-text">{s.text}</p>
                  <ul class="film-points">
                    {s.points.map((p) => (
                      <li>
                        <Icon name="check" size={18} class="mt-0.5 text-accent" />
                        <span>{p}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
          <nav class="film-rail" aria-label="Scenes of the tour">
            {
              film.map((s) => (
                <a href={`#scene-${s.id}`} data-rail>
                  <span class="film-bar" aria-hidden="true" />
                  {s.label}
                </a>
              ))
            }
          </nav>
        </div>
        <div class="film-view">
          <div class="film-glow" aria-hidden="true"></div>
          <div class="film-cam">
            <div class="film-window" data-demo="/demo/?film">
              <img
                class="film-poster"
                src="/tour.webp"
                alt="The Magnetite window: a sidebar with favorites, the space “Work” with pinned tabs, a folder of review requests and today’s tabs, beside an open page."
                width="1280"
                height="800"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
    <p class="film-note mx-auto max-w-7xl px-5">
      Not a recording: the sidebar and the command bar in this window are Magnetite’s own code, running on sample tabs.
      <a href="/demo/" class="link whitespace-nowrap">Try the live demo</a>
    </p>
  </section>

  <!-- Import -->
  <section class="mx-auto max-w-7xl px-5 pt-16 sm:pt-24" aria-labelledby="import-title" data-reveal>
    <div class="glass grid gap-8 rounded-3xl p-6 sm:p-8 lg:grid-cols-[1fr_1.15fr] lg:gap-14 lg:p-10">
      <div>
        <span class="orb"><Icon name="import" size={20} /></span>
        <h2 id="import-title" class="mt-5 font-display text-2xl font-semibold tracking-[-0.01em] sm:text-3xl">
          Moving from another browser?
        </h2>
        <p class="mt-3 leading-relaxed text-secondary">
          Settings → Data → Import from another browser lists the browsers on your computer, and one click adds their
          spaces and tabs next to yours.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Browsers Magnetite imports from">
          {importSources.map((b) => <li class="source">{b}</li>)}
        </ul>
      </div>
      <div class="grid content-start gap-7 sm:grid-cols-2 lg:pt-1">
        <div>
          <h3 class="eyebrow">Comes along</h3>
          <ul class="mt-4 space-y-2.5 text-[0.9375rem] leading-snug text-secondary">
            {
              imported.map((t) => (
                <li class="flex gap-2.5">
                  <Icon name="check" size={17} class="mt-px text-accent" />
                  <span>{t}</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="eyebrow">Stays behind</h3>
          <ul class="mt-4 space-y-2.5 text-[0.9375rem] leading-snug text-secondary">
            {
              notImported.map((t) => (
                <li class="flex gap-2.5">
                  <span class="skip" aria-hidden="true"></span>
                  <span>{t}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-5 text-sm leading-relaxed text-muted">
            Everything is read on your computer and nothing is uploaded. Magnetite is an independent project, not
            affiliated with The Browser Company.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="mx-auto max-w-7xl px-5 pt-16 sm:pt-24" aria-labelledby="why-title">
    <h2 id="why-title" class="sr-only">Why Magnetite</h2>
    <ul class="grid gap-5 md:grid-cols-3">
      {
        reasons.map((r, i) => (
          <li class:list={["card spot p-7", `d-${i}`]} data-reveal>
            <span class="orb">
              <Icon name={r.icon} size={20} />
            </span>
            <h3 class="mt-6 font-display text-xl font-semibold">{r.title}</h3>
            <p class="mt-3 leading-relaxed text-secondary">{r.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Keyboard -->
  <section class="mx-auto max-w-7xl px-5 pt-16 sm:pt-24" aria-labelledby="keys-title">
    <div class="keys card overflow-hidden p-7 sm:p-10" data-reveal>
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="keys-title" class="font-display text-2xl font-semibold tracking-[-0.01em]">Hands stay on the keys.</h2>
        <fieldset class="os-switch">
          <legend class="sr-only">Show the shortcuts for</legend>
          <label><input type="radio" name="keys-os" value="mac" checked />macOS</label>
          <label><input type="radio" name="keys-os" value="pc" />Windows &amp; Linux</label>
        </fieldset>
      </div>
      <ul class="mt-8 grid grid-cols-2 gap-x-4 gap-y-6 sm:gap-x-8 lg:grid-cols-5">
        {
          shortcuts.map((s) => (
            <li class="keyset">
              <span class="keys-mac flex gap-1.5">
                {s.keys.map((k) => (
                  <kbd class="cap">{k}</kbd>
                ))}
              </span>
              <span class="keys-pc flex gap-1.5">
                {s.keys.map((k) => (
                  <kbd class="cap">{pcKey[k] ?? k}</kbd>
                ))}
              </span>
              <span class="text-sm text-secondary">{s.what}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Everything else -->
  <section class="mx-auto max-w-7xl px-5 pt-16 sm:pt-24" aria-labelledby="more-title">
    <div class="max-w-2xl">
      <p class="eyebrow" data-reveal>And the rest</p>
      <h2 id="more-title" class="section-title mt-5 font-display" data-reveal>Small things, done properly.</h2>
    </div>
    <div class="show mt-10" data-show>
      <ul class="show-cards">
        {
          features.map((f, i) => (
            <li
              class:list={["show-card card spot", `d-${i % 3}`]}
              data-reveal
              data-card={f.scene}
              data-focus={f.focus}
              data-still={f.still}
              data-shot={f.shot}
              data-shot-first={f.first}
              data-shot-pad={f.pad}
              data-shot-max={f.max}
            >
              {/* Decorative: the card says the same in words. */}
              <div class="piece">
                <img src={`/cards/${f.scene}.webp`} alt="" loading="lazy" decoding="async" />
              </div>
              <div class="min-w-0">
                <h3 class="font-display text-lg font-semibold">{f.title}</h3>
                <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-secondary">{f.text}</p>
              </div>
            </li>
          ))
        }
