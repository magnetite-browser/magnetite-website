          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href="/download/" class="btn btn-primary" data-magnetic="0.25"><Icon name="download" size={17} />Download</a>
            <a href={docs.building} class="btn btn-secondary" data-magnetic="0.25">Build from source</a>
          </div>
        </div>
        <ul class="space-y-2.5 text-sm">
          {
            PLATFORMS.map((p, i) => (
              <li class:list={["platform", `d-${i}`]} data-reveal>
                <span class="font-medium">
                  {p.os} <span class="text-muted">· {p.arch}</span>
