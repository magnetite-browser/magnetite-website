  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border: 1px solid rgb(215 166 101 / 0.3);
    border-radius: 999px;
    background: rgb(215 166 101 / 0.07);
    color: var(--color-champagne);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse-ring 1.8s ease-out infinite;
  }
  .hero-title {
    margin-top: 1.75rem;
    font-size: clamp(3.25rem, 8.6vw, 7.25rem);
    font-weight: 650;
    letter-spacing: -0.045em;
    line-height: 0.92;
  }
  .load {
    animation: rise 1.2s var(--ease-out-expo) both;
    animation-delay: calc(0.15s + var(--i, 0) * 0.12s);
  }
  .load-pop {
    animation: magnet-in 1.6s var(--ease-out-expo) both;
  }
  .magnet {
    position: relative;
    display: grid;
    place-items: center;
    width: min(78vw, 440px);
    aspect-ratio: 1;
  }
  @media (max-width: 1023px) {
    .magnet {
      width: min(56vw, 260px);
    }
  }
  .magnet {
    transition: transform 600ms var(--ease-out-expo);
    transform: perspective(900px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
  }
  .magnet :global(.magnet-logo) {
    position: relative;
    width: 74%;
    height: 74%;
    border-radius: 22%;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.07),
      inset 0 1px 0 rgb(255 255 255 / 0.1);
    filter: drop-shadow(0 40px 60px rgb(0 0 0 / 0.8)) drop-shadow(0 0 50px rgb(226 98 43 / 0.25));
    animation: float 8s ease-in-out infinite;
  }
  .halo {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(226 98 43 / 0.2), rgb(215 166 101 / 0.08) 45%, transparent 66%);
    animation: breathe 6s ease-in-out infinite;
  }
  .halo-2 {
    inset: -10%;
    border: 1px solid rgb(226 98 43 / 0.16);
    background: none;
    animation: ripple 6s ease-out infinite;
  }
  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 22px;
    display: none;
    width: 26px;
    height: 40px;
    translate: -50% 0;
    border: 1.5px solid rgb(255 255 255 / 0.2);
    border-radius: 999px;
  }
  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 4px;
    height: 8px;
    margin-left: -2px;
    border-radius: 2px;
    background: var(--color-accent);
    animation: cue 1.8s ease-in-out infinite;
  }
  @media (min-width: 1024px) and (min-height: 760px) {
    .scroll-cue {
      display: block;
    }
  }

  /* Ticker */
  .spark {
    color: var(--color-accent);
    font-size: 0.8em;
  }

  .section-title {
    font-size: clamp(2.4rem, 5.2vw, 4rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  /* Tour. src/scripts/film.ts sets data-mode, data-scene, data-live and
     data-current, and the properties --scenes (how many), --t (progress of
     the scene), --entered and --cut. Without it: the picture of the window,
     then the captions as a list. */
  .film-stage {
    display: flex;
    flex-direction: column;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1.25rem;
  }
  .film-view {
    position: relative;
    order: -1;
  }
  .film-glow {
    position: absolute;
    inset: 6% 0;
    background:
      radial-gradient(45% 50% at 40% 50%, rgb(215 166 101 / 0.22), transparent 70%),
      radial-gradient(40% 40% at 15% 65%, rgb(147 164 184 / 0.12), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }
  /* Spaces tint the window; the light behind it follows (Home is green). */
  .film-glow::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(45% 50% at 40% 50%, rgb(143 196 150 / 0.2), transparent 70%);
    opacity: 0;
    transition: opacity 700ms;
  }
  .film:is([data-scene="spaces"], [data-scene="command"]) .film-glow::after {
    opacity: 1;
  }
  .film-window {
    position: relative;
    aspect-ratio: 1280 / 800;
    overflow: hidden;
    border-radius: 14px;
    background: var(--color-bg);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.1),
      0 50px 120px -30px rgb(0 0 0 / 0.9),
      0 0 80px -20px rgb(215 166 101 / 0.25);
  }
  .film-poster {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* The live window (a frame film.ts adds) covers the picture once it runs. */
  .film-window :global(.film-frame) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    color-scheme: dark;
    opacity: 0;
    transition: opacity 400ms;
  }
  .film[data-live] .film-window :global(.film-frame) {
    opacity: 1;
  }
  .film-copy {
    display: flex;
    flex-direction: column;
  }
  .film-scenes {
    display: grid;
    gap: 3rem 4rem;
    margin-top: 3rem;
  }
  @media (min-width: 768px) {
    .film-scenes {
      grid-template-columns: 1fr 1fr;
    }
  }
  .film-count {
    color: var(--color-champagne);
  }
  .film-title {
    margin-top: 1rem;
    font-size: clamp(2rem, 3.3vw, 2.875rem);
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }
  .film-text {
    margin-top: 1rem;
    color: var(--color-secondary);
    font-size: 1.0625rem;
    line-height: 1.6;
  }
  .film-points {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.25rem;
    color: var(--color-secondary);
  }
  .film-points li {
    display: flex;
    gap: 0.75rem;
  }
  .film-rail {
    display: none;
  }
  .film-note {
    margin-top: 2rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  /* With the script: one caption at a time, in the same place; the window
     is 1280 × 800 and the camera (a transform from film.ts) moves it so the
     scene's part fills the view. */
  .film[data-mode] .film-cam {
    position: absolute;
    left: 0;
    top: 0;
    width: 1280px;
    height: 800px;
    transform-origin: 0 0;
  }
  .film[data-mode] .film-window {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }
  .film[data-mode] .film-scenes {
    grid-template-columns: 1fr;
    gap: 0;
    margin-top: 0;
  }
  .film[data-mode] .film-scene {
    grid-area: 1 / 1;
    opacity: 0;
    translate: 0 20px;
    pointer-events: none;
    transition:
      opacity 300ms,
      translate 700ms var(--ease-out-expo);
  }
  .film[data-mode] .film-scene[data-current] {
    opacity: 1;
    translate: 0 0;
    pointer-events: auto;
    transition-delay: 140ms;
  }
  /* The rail: a link per scene with a bar that fills as the scene plays. */
  .film[data-mode] .film-rail {
    display: flex;
    gap: 0.5rem;
  }
  .film-rail a {
    position: relative;
    color: var(--color-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
    transition: color 250ms;
  }
  .film-rail a:hover,
  .film-rail a[data-current] {
    color: var(--color-fg);
  }
  .film-bar {
    position: absolute;
    overflow: hidden;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.12);
  }
  .film-bar::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    transform-origin: 0 50%;
    scale: 0 1;
  }
  .film-rail a[data-done] .film-bar::after {
    scale: 1 1;
  }
  .film-rail a[data-current] .film-bar::after {
    scale: var(--t, 0) 1;
  }

  /* In the page (small screens, or reduced motion): the window in a box
     that the camera looks through, the scenes as chips under it. */
  .film[data-mode="auto"] .film-view {
    aspect-ratio: 1 / 0.95;
    max-height: 38rem;
    overflow: hidden;
    border: 1px solid var(--color-line-strong);
    border-radius: 18px;
    background: var(--color-ink-2);
  }
  @media (min-width: 640px) {
    .film[data-mode="auto"] .film-view {
      aspect-ratio: 16 / 10;
    }
  }
  .film[data-mode="auto"] .film-glow {
    display: none;
  }
  .film[data-mode="auto"] .film-window {
    border-radius: 14px;
    box-shadow: none;
  }
  .film[data-mode="auto"] .film-rail {
    order: -1;
    margin: 1.25rem -1.25rem 1.75rem;
    padding: 0 1.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .film[data-mode="auto"] .film-rail a {
    flex: none;
    padding: 0.45rem 0.9rem 0.55rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    overflow: hidden;
  }
  .film[data-mode="auto"] .film-rail a[data-current] {
    border-color: rgb(215 166 101 / 0.55);
    background: rgb(215 166 101 / 0.08);
  }
  .film[data-mode="auto"] .film-bar {
    inset: auto 0 0;
    height: 2px;
    border-radius: 0;
    background: none;
  }

  /* Pinned (large screens with motion): the stage sticks below the header
     for one screen plus 90 % of one per scene. The captions are a column on
     the left; the window starts beside it and runs off the right edge of the
     screen at full size, and comes in tilted while the stage rises. */
  .film[data-mode="scroll"] .film-track {
    height: calc(100svh - 4rem + var(--scenes) * 90svh);
  }
  .film[data-mode="scroll"] .film-stage {
    position: sticky;
    top: 4rem;
    display: grid;
    grid-template-columns: clamp(17rem, 28vw, 23rem) minmax(0, 1fr);
    gap: 2rem;
    max-width: none;
    height: calc(100svh - 4rem);
    padding: 0 0 0 max(1.25rem, (100vw - 80rem) / 2 + 1.25rem);
  }
  .film[data-mode="scroll"] .film-copy {
    position: relative;
    justify-content: center;
    padding-bottom: 5rem;
    opacity: calc(var(--entered, 1) * 2 - 1);
  }
  /* Where the camera moves the window's left part out of the view, it is
     cut at the view's edge and fades into the page there (--cut, 0 to 1). */
  .film[data-mode="scroll"] .film-view {
    order: 0;
    height: 100%;
    clip-path: inset(-50vh -50vw -50vh 0);
  }
  .film[data-mode="scroll"] .film-view::after {
    content: "";
    position: absolute;
    inset: 0 auto 0 0;
    width: 5rem;
    background: linear-gradient(90deg, var(--color-ink), transparent);
    opacity: var(--cut, 0);
    pointer-events: none;
  }
  .film[data-mode="scroll"] .film-window {
    transform-origin: 30% 100%;
    transform: perspective(1800px) rotateX(calc((1 - var(--entered, 1)) * 18deg))
      translateY(calc((1 - var(--entered, 1)) * 60px)) scale(calc(0.88 + 0.12 * var(--entered, 1)));
    opacity: calc(var(--entered, 1) * 2.5);
  }
  .film[data-mode="scroll"] .film-rail {
    position: absolute;
    inset: auto 0 2.5rem;
    display: grid;
    grid-template-columns: repeat(var(--scenes), minmax(0, 1fr));
    gap: 0.4rem;
  }
  .film[data-mode="scroll"] .film-rail a {
    height: 2.75rem;
    padding-top: 1.1rem;
    color: transparent;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .film[data-mode="scroll"] .film-rail a[data-current] {
    color: var(--color-champagne);
  }
  .film[data-mode="scroll"] .film-bar {
    inset: 0.5rem 0 auto;
    height: 3px;
  }
  @media (max-height: 760px) {
    .film[data-mode="scroll"] .film-points {
      display: none;
    }
  }

  /* Import panel */
  .source {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.03);
    color: var(--color-fg);
    font-size: 0.875rem;
  }
  .skip {
    flex: none;
    width: 17px;
    height: 17px;
    margin-top: 1px;
    background: linear-gradient(var(--color-muted), var(--color-muted)) center / 10px 1.5px no-repeat;
  }

  .orb {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 14px;
    background: radial-gradient(circle at 30% 25%, rgb(246 223 176 / 0.25), rgb(215 166 101 / 0.08) 60%);
    box-shadow:
      inset 0 0 0 1px rgb(215 166 101 / 0.35),
      0 0 24px -6px rgb(215 166 101 / 0.5);
    color: var(--color-champagne);
  }

  /* Keyboard */
  .keyset {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
