    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "@emnapi/runtime": "1.11.3"
    }
  }
