# The site inside its image: plain HTTP on 8080, for a reverse proxy that
# holds the certificate. Caddy writes no access log unless told to, which
# keeps the privacy policy short, and here it writes no files at all.
{
	admin off
	persist_config off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip
	file_server
	# Unknown addresses get the site's own 404 page.
	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
	# The same policy as the <meta> tag in every page (src/layouts/Base.astro),
	# plus frame-ancestors, which only works as a header;
	# scripts/smoke-test.sh compares the two. The one other origin is our
	# visitor statistics server. Frames: the home page shows this site's own
	# /demo/ page, and nothing else may frame or be framed.
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self' https://umami.stack-forge.cloud; connect-src https://umami.stack-forge.cloud; img-src 'self'; style-src 'self'; font-src 'self'; frame-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	# Built files carry a hash of their content in their name.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
}
